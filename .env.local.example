NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser. Used by the daily cron
# jobs (src/lib/supabase/admin.ts) to read/write across all users, bypassing
# RLS — the cron routes have no logged-in user/cookies to scope by.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID). Generate a keypair with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose (NEXT_PUBLIC_ prefix, sent to the browser
# for pushManager.subscribe). The private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` —
# generate any random string (e.g. `openssl rand -hex 32`) and set the same
# value here and in Vercel's project env vars.
CRON_SECRET=your-random-cron-secret
